{"id": "viva_casebook.composites.bounded-cell", "name": "bounded-cell", "description": "A bounded, goal-directed cell \u2014 TemperatureRamp + MonodUptake + YieldGrowth + ThermalDeath (t_tol=43 C): biomass grows on the nutrient it consumes (mass-conserving, Monod-saturating) while viability holds below the temperature tolerance then collapses once the rising temperature exceeds it.", "parameters": {}, "state": {"nutrient": 10.0, "biomass": 0.5, "viability": 1.0, "temperature": 37.0, "uptake_flux": 0.0, "ramp": {"_type": "process", "address": "local:TemperatureRamp", "config": {"t_start": 37.0, "t_end": 50.0, "duration": 8.0}, "inputs": {"temperature": ["temperature"]}, "outputs": {"temperature": ["temperature"]}, "interval": 0.02}, "monod": {"_type": "process", "address": "local:MonodUptake", "config": {"qmax": 3.0, "Ks": 0.02}, "inputs": {"nutrient": ["nutrient"], "biomass": ["biomass"], "uptake_flux": ["uptake_flux"]}, "outputs": {"nutrient": ["nutrient"], "uptake_flux": ["uptake_flux"]}, "interval": 0.02}, "growth": {"_type": "process", "address": "local:YieldGrowth", "config": {"Y": 0.45}, "inputs": {"uptake_flux": ["uptake_flux"]}, "outputs": {"biomass": ["biomass"]}, "interval": 0.02}, "thermal": {"_type": "process", "address": "local:ThermalDeath", "config": {"t_tol": 43.0, "k_death": 0.8}, "inputs": {"temperature": ["temperature"], "viability": ["viability"]}, "outputs": {"viability": ["viability"]}, "interval": 0.02}}, "schema": {}, "overrides": {}, "requires": {"processes": ["TemperatureRamp", "MonodUptake", "YieldGrowth", "ThermalDeath"]}, "tags": ["agentic-challenges", "bounded-cell", "metabolism"], "visualizations": [], "analyses": [], "emitters": [], "kind": "spec", "module": "", "default_n_steps": null, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}