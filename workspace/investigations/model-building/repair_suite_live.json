      "fit": {
        "fitted": {
          "KM": 40.0
        },
        "resim_rmsd": 3e-06,
        "matched": true,
        "method": "Levenberg - Marquardt"
      },
      "localize": {
        "diagnosed_parameter": "KM",
        "correct": true,
        "moved_from_broken": {
          "n": 0.0,
          "KM": 40.0,
