{
  "schema": "repair_suite_pe/v1",
  "task": "break-and-repair via COPASI parameter estimation",
  "model": "repressilator (SBML) simulated in the real COPASI backend",
  "oracle": "COPASI Parameter Estimation (Levenberg\u2013Marquardt) fitting the intact reference time-course \u2014 recall-free by construction; the optimizer never sees a canonical value",
  "driver": "deterministic demonstration of the PE repair + recall-free localization machinery \u2014 no LLM recall; every value is real COPASI PE output (reproduce: python scripts/gen_repair_demo.py)",
  "candidate_parameters": [
    "n",
    "KM",
    "translation efficiency"
  ],
  "runs": [
    {
      "break_id": "repair-01",
      "param": "n",
      "blurb": "the cooperative-repression Hill coefficient",
      "broken_value": 1.0,
      "true_value": 2.0,
      "broken_rmsd": 0.307,
      "fit": {
        "fitted": {
          "n": 2.0
        },
        "resim_rmsd": 9e-05,
        "matched": true,
        "method": "Levenberg - Marquardt"
      },
      "localize": {
        "diagnosed_parameter": "n",
        "correct": true,
        "moved_from_broken": {
          "n": 1.0,
          "KM": 0.0,
          "translation efficiency": 0.0
        }
      }
    },
    {
      "break_id": "repair-02",
      "param": "KM",
