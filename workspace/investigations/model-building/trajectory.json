{
  "schema": "model_build_trajectory/v2",
  "study": "bounded-cell",
  "contract": {
    "question": "Build a bounded, goal-directed cell: on a finite nutrient pool and a rising temperature, produce a cell whose BIOMASS grows on the nutrient it CONSUMES (mass-conserving, Monod-saturating GROWTH), and whose VIABILITY holds while below its temperature tolerance then collapses once temperature exceeds it.",
    "observables": [
      "biomass (gDW/L)",
      "nutrient (mM glucose)",
      "viability",
      "temperature (\u00b0C, driven)"
    ],
    "success": "all 5 hard acceptance tests pass; 1 directional test rides along"
  },
  "draft": {
    "description": "A real process-bigraph composite with the exchange stores and the temperature driver, but NO mechanism processes behind the ports \u2014 the inert starting point the loop compiles into a running cell.",
    "ports": [
      "biomass",
      "nutrient",
      "viability",
      "temperature (driven)"
    ],
    "composite": {
      "engine": "process_bigraph.Composite",
      "stores": [
        "nutrient (mM)",
        "biomass (gDW/L)",
        "viability",
        "temperature (\u00b0C)",
        "uptake_flux"
      ],
      "processes": [
        {
          "node": "ramp",
          "address": "local:TemperatureRamp",
          "reads": [
            "temperature"
          ],
          "writes": [
            "temperature"
          ]
        }
      ]
    }
  },
  "final_composite": {
    "engine": "process_bigraph.Composite",
    "stores": [
      "nutrient (mM)",
      "biomass (gDW/L)",
      "viability",
      "temperature (\u00b0C)",
      "uptake_flux"
    ],
    "processes": [
      {
        "node": "ramp",
        "address": "local:TemperatureRamp",
        "reads": [
          "temperature"
        ],
        "writes": [
          "temperature"
        ]
      },
      {
        "node": "monod_uptake",
        "address": "local:MonodUptake",
        "reads": [
          "nutrient",
          "biomass"
        ],
        "writes": [
          "nutrient",
          "uptake_flux"
        ]
      },
      {
        "node": "yield_growth",
        "address": "local:YieldGrowth",
        "reads": [
          "uptake_flux"
        ],
        "writes": [
          "biomass"
        ]
      },
      {
        "node": "thermal_death",
        "address": "local:ThermalDeath",
        "reads": [
          "temperature",
          "viability"
        ],
        "writes": [
          "viability"
        ]
      }
    ]
  },
  "select": {
